{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cassandra-devils-advocate": {
      "root": ".",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "cassandra-devils-advocate"
      }
    }
  ]
}
